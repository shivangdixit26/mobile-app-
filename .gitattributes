# Store text files with LF line endings, so they work on macOS and Linux too.
* text=auto

# Shell script: must keep LF, or macOS cannot run it ("bad interpreter").
gradlew text eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf

# Binary files: never touch line endings.
*.jar binary
*.png binary
*.apk binary
